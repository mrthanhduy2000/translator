{
    "manifest_version": 3,
    "name": "Vietnamese Subtitle Translator (Coursera + YouTube)",
    "description": "Dich phu de Coursera va YouTube sang tieng Viet, co long tieng",
    "version": "8.0.0",
    "icons": {
        "16": "icons/icon.png",
        "32": "icons/icon.png",
        "48": "icons/icon.png",
        "128": "icons/icon.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon.png",
            "32": "icons/icon.png",
            "48": "icons/icon.png",
            "128": "icons/icon.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*"
            ],
            "js": [
                "yt-bridge.js"
            ],
            "world": "MAIN",
            "run_at": "document_start",
            "all_frames": false
        },
        {
            "matches": [
                "*://*.coursera.org/*",
                "*://learn.deeplearning.ai/*",
                "*://*.youtube.com/*"
            ],
            "js": [
                "glossary.js",
                "dubbing.js",
                "content.js",
                "youtube.js"
            ],
            "run_at": "document_idle",
            "all_frames": false
        }
    ],
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "*://*.coursera.org/*",
        "*://learn.deeplearning.ai/*",
        "*://*.youtube.com/*",
        "https://translate.googleapis.com/*"
    ],
    "options_page": "options.html"
}